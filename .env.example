# Copy to .env and fill in the values for your chosen providers.
# cp .env.example .env

# --- LLM providers (set default_provider in config.yaml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VLLM_BASE_URL=http://localhost:8080/v1

# --- Database: PostgreSQL (db_provider: postgresql) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentdesk
POSTGRES_READONLY_USER=agentdesk_readonly
POSTGRES_READONLY_PASSWORD=
DB_PASSWORD=changeme

# --- Database: Neon (db_provider: neon) ---
# https://neon.tech → Project > Settings > Connection Details
NEON_DATABASE_URL=
NEON_API_KEY=

# --- Database: Supabase (db_provider: supabase) ---
# https://supabase.com → Project > Settings > Database > Connection string (Transaction pooler)
SUPABASE_DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
